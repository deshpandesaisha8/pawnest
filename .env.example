DB_HOST=localhost
DB_PORT=3306
DB_USER=pawnest_app
DB_PASSWORD=ChangeMe123!
DB_NAME=pawnest
SECRET_KEY=paste-a-long-random-string-here
ADMIN_CODE=1234

# Optional: least-privilege users from sql/roles.sql (leave commented to use DB_USER for everything)
# DB_ADMIN_USER=pawnest_admin
# DB_ADMIN_PASSWORD=ChangeAdminPass1!
# DB_ADOPTER_USER=pawnest_adopter
