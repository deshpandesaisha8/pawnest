# Optional email alerts (leave SMTP_HOST empty to turn off). Gmail: smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WhatsApp alerts through Twilio (leave TWILIO_SID empty to turn off). Numbers are sent with +91.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=14155238886
